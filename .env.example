# Copy to .env and fill in. Read by BOTH the Python embed server and the .NET backend.
# The .NET backend searches upward from its run directory for this file, so a single
# .env at the repo root works for everything.

# ── Neo4j (your local "profiscal" DBMS) ──
# Used by embed_server.py AND the .NET backend (NEO4J_* fallback).
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=          # ← your Neo4j password
NEO4J_DATABASE=tunisian-fiscal

# ── LLM (used by the .NET backend for chat / consultations / refinement) ──
# IMPORTANT: the .NET app binds these from config, so use the DOUBLE-underscore form.
OpenAI__ChatModel=gpt-4o
OpenAI__ApiKey=          # ← sk-... key (or your EY Azure key)
# For EY Azure OpenAI instead, also set:
# OpenAI__Endpoint=https://eyq-incubator.europe.fabric.ey.com/eyq/eu/api
# OpenAI__ApiVersion=2024-02-15-preview

# ── Optional overrides ──
# JWT__KEY=change-me-for-shared-deployments
# EmbedServer__Url=http://127.0.0.1:8081/embed_search

# ── SQL Server connection string (overrides appsettings.json's ConnectionStrings:DefaultConnection) ──
# The instance name is machine-specific (e.g. "XWJQW76J3", ".\SQLEXPRESS", "localhost"), so it
# belongs here, not in the tracked appsettings.json. Trusted_Connection=True means Windows
# Integrated Auth — there is no password to protect, but the server name still shouldn't be
# hardcoded into a file every clone shares.
# ConnectionStrings__DefaultConnection=Server=YOUR_INSTANCE;Database=ProfiscalDb;Trusted_Connection=True;TrustServerCertificate=True;
