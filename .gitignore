# Build directories
backend/*/bin/
backend/*/obj/
frontend/build/
frontend/node_modules/

# SQLite database + WAL files (runtime artifacts — never commit)
*.db
*.db-shm
*.db-wal

# .NET user-secrets (local-only, never commit)
secrets.json
appsettings.*.local.json
# Production config lives ONLY on the server (holds the real OpenAI key, Jwt:Key, Neo4j
# password, seed admin password). Ignored so it can never be pushed. Deploy it by hand.
appsettings.Production.json
**/appsettings.Production.json

# Dependencies
node_modules/
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
.vs/
**/.vs/
*.csproj.user
*.swp
*.swo
*~

# Local corporate CA bundle (path is per-machine; not needed by every clone)
*.pem

# OS
.DS_Store
Thumbs.db

# Model cache (optional - remove if you want to include it)
model_cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Local notes
todo.txt
STEPS.txt
# migration backup dumps (large, machine-local)
taxmindvf_cdpf_backup.json
cdpf_bct_export.json

# ── Vendored qEntropy chunker (chunker/) — build artifacts & secrets ──
chunker/**/node_modules/
chunker/**/venv/
chunker/**/__pycache__/
chunker/**/*.pyc
chunker/.env
chunker/**/model_cache/
chunker/**/.vite/
chunker/frontend/dist/
chunker/backend/uploads/
chunker/backend/jobs/

# ── ONNX embedding model (carried per-machine, not versioned) ──
# model.onnx is ~450 MB — over GitHub's file limit. Produce it with
# tools/onnx/export_model.py, or copy it from another machine.
backend/Profiscal.Application/models/embedding/model.onnx
tools/onnx/*.onnx
